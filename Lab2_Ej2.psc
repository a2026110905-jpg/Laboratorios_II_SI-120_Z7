Algoritmo Lab2_Ej2
	Definir Precio_del_producto, Precio_total Como Real
	Definir Cantidad_de_productos Como Entero
	Escribir "Cuál es el precio de su producto?"
	Leer Precio_del_producto
	Escribir "Cuántas unidades de este producto está comprando?"
	Leer Cantidad_de_productos
	Precio_total = Precio_del_producto * Cantidad_de_productos
	Escribir "El precio total es: " Precio_total
FinAlgoritmo
