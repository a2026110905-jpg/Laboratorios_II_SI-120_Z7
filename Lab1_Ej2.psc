Algoritmo Presentación_Personal
	Definir Nombre Como Caracter
	Definir Edad Como Entero
	Escribir "Por favor, ingresar nombre de usuario"
	Leer Nombre
	Escribir " Por favor, ingresar edad del usuario"
	Leer Edad
	Escribir "Nombre del usuario: " Nombre
	Escribir "Nombre del usuario: " Edad
FinAlgoritmo
